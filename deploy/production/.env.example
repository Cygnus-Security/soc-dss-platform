POSTGRES_DB=socdss
POSTGRES_USER=socdss
POSTGRES_PASSWORD=change_me_strong_password
CORS_ALLOWED_ORIGINS=*
SESSION_COOKIE_SAME_SITE=strict
SESSION_COOKIE_SECURE=false
POSTGRES_DATA_DIR=./runtime/postgres/data
POSTGRES_BACKUP_DIR=./runtime/postgres/backups
BACKEND_LOG_DIR=./runtime/backend/logs
FRONTEND_LOG_DIR=./runtime/frontend/logs
REPORT_OUTPUT_DIR=./runtime/reports
REDPANDA_DATA_DIR=./runtime/redpanda/data
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CONSUMER_GROUP=soc-dss-ingestion-v1
APP_KAFKA_ENABLED=true
ACTION_APPROVAL_SECRET=replace-with-at-least-32-random-characters
ACTION_APPROVAL_TTL_MINUTES=60
SOAR_ACTION_BATCH_SIZE=50
SOAR_ACTION_DELAY_MS=100
SOAR_EXECUTION_MODE=dry-run
SOAR_ACTION_WEBHOOK_URL=
SOAR_ACTION_WEBHOOK_TOKEN=

# Isolated Metasploitable2 response lab. Do not change these addresses unless
# the selected subnets overlap another Docker network on the host.
METASPLOITABLE_ATTACK_SUBNET=172.31.252.0/24
METASPLOITABLE_ATTACKER_IP=172.31.252.10
METASPLOITABLE_VICTIM_IP=172.31.252.20
METASPLOITABLE_CONTROL_SUBNET=172.31.253.0/29
METASPLOITABLE_SOAR_IP=172.31.253.2
METASPLOITABLE_EXECUTOR_IP=172.31.253.3
METASPLOITABLE_BLOCK_TTL_SECONDS=120
