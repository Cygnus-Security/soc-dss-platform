<!--
  Wazuh agent sidecar for the Metasploitable2 victim.

  The official Wazuh container entrypoint replaces the CHANGE_* placeholders
  below from environment variables. The sidecar reads the victim's shared
  /var/log volume read-only and does not modify the vulnerable host.
-->
<ossec_config>
  <client>
    <server>
      <address>CHANGE_MANAGER_IP</address>
      <port>CHANGE_MANAGER_PORT</port>
      <protocol>tcp</protocol>
    </server>
    <config-profile>linux,ubuntu,metasploitable2</config-profile>
    <notify_time>10</notify_time>
    <time-reconnect>30</time-reconnect>
    <auto_restart>yes</auto_restart>
    <crypto_method>aes</crypto_method>
    <enrollment>
      <enabled>yes</enabled>
      <manager_address>CHANGE_ENROLL_IP</manager_address>
      <port>CHANGE_ENROLL_PORT</port>
      <agent_name>CHANGE_AGENT_NAME</agent_name>
      <authorization_pass_path>etc/authd.pass</authorization_pass_path>
      <groups>CHANGE_AGENT_GROUP</groups>
    </enrollment>
  </client>

  <client_buffer>
    <disabled>no</disabled>
    <queue_size>5000</queue_size>
    <events_per_second>200</events_per_second>
  </client_buffer>

  <localfile>
    <location>/metasploitable-logs/auth.log</location>
    <log_format>syslog</log_format>
    <label key="@asset">soc-dss-metasploitable2-victim</label>
  </localfile>

  <localfile>
    <location>/metasploitable-logs/syslog</location>
    <log_format>syslog</log_format>
    <label key="@asset">soc-dss-metasploitable2-victim</label>
  </localfile>

  <localfile>
    <location>/metasploitable-logs/apache2/access.log</location>
    <log_format>apache</log_format>
    <label key="@asset">soc-dss-metasploitable2-victim</label>
  </localfile>

  <localfile>
    <location>/metasploitable-logs/apache2/error.log</location>
    <log_format>apache</log_format>
    <label key="@asset">soc-dss-metasploitable2-victim</label>
  </localfile>

  <localfile>
    <location>/metasploitable-logs/vsftpd.log</location>
    <log_format>syslog</log_format>
    <label key="@asset">soc-dss-metasploitable2-victim</label>
  </localfile>

  <localfile>
    <location>/metasploitable-logs/proftpd/proftpd.log</location>
    <log_format>syslog</log_format>
    <label key="@asset">soc-dss-metasploitable2-victim</label>
  </localfile>

  <localfile>
    <location>/metasploitable-logs/samba/log.*</location>
    <log_format>syslog</log_format>
    <label key="@asset">soc-dss-metasploitable2-victim</label>
  </localfile>

  <logging>
    <log_format>plain</log_format>
  </logging>
</ossec_config>
